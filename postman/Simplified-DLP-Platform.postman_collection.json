{
  "info": {
    "name": "Simplified DLP Platform",
    "description": "Runnable tour of the API. Start the stack with `docker compose up`, then Run collection. Each request saves the ids the next ones need; Cleanup deletes everything it created.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "suffix",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get(\"suffix\")) { pm.collectionVariables.set(\"suffix\", Date.now().toString()); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Data Types",
      "item": [
        {
          "name": "Create Financial",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/datatypes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "datatypes"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Financial {{suffix}}\",\n  \"type\": \"keywords\",\n  \"content\": [\n    \"salary\",\n    \"bonus\",\n    \"payroll\"\n  ],\n  \"threshold\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"defaults applied\", () => { const b = pm.response.json(); pm.expect(b.description).to.eql(\"\"); pm.expect(b.case_sensitive).to.eql(false); });",
                  "pm.collectionVariables.set(\"financialId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Project Falcon",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/datatypes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "datatypes"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Project Falcon {{suffix}}\",\n  \"type\": \"keywords\",\n  \"content\": [\n    \"falcon\"\n  ],\n  \"threshold\": 1,\n  \"description\": \"Codename of an unreleased product\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"falconId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List Data Types (paginated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/datatypes?limit=50&offset=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "datatypes"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"returns a list\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Financial",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/datatypes/{{financialId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "datatypes",
                "{{financialId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Replace Financial (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/datatypes/{{financialId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "datatypes",
                "{{financialId}}"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Financial {{suffix}}\",\n  \"type\": \"keywords\",\n  \"content\": [\n    \"salary\",\n    \"bonus\",\n    \"payroll\"\n  ],\n  \"threshold\": 2,\n  \"description\": \"HR compensation data\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"description replaced\", () => pm.expect(pm.response.json().description).to.eql(\"HR compensation data\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Data Sets",
      "item": [
        {
          "name": "Create HR policy",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/datasets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "datasets"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"HR policy {{suffix}}\",\n  \"data_type_ids\": [\n    \"{{financialId}}\",\n    \"{{falconId}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"links both Data Types\", () => pm.expect(pm.response.json().data_type_ids).to.have.lengthOf(2));",
                  "pm.collectionVariables.set(\"dataSetId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get HR policy",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/datasets/{{dataSetId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "datasets",
                "{{dataSetId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "List Data Sets (paginated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/datasets?limit=50&offset=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "datasets"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Scan",
      "item": [
        {
          "name": "Scan: match (strongest first)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/scan",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "scan"
              ]
            },
            "description": "Financial: salary + bonus = 2 >= threshold 2. Project Falcon: 'Falcon' = 1 >= 1 (case-insensitive). OR logic: any Data Type firing = match.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dataset_id\": \"{{dataSetId}}\",\n  \"text\": \"The salary and bonus numbers for Falcon are attached.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"match, Financial (2) then Falcon (1)\", () => { const b = pm.response.json(); pm.expect(b.status).to.eql(\"match\"); pm.expect(b.detected_objects.map(d => d.match_count)).to.eql([2, 1]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Scan: not matched",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/scan",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "scan"
              ]
            },
            "description": "Financial: payroll = 1 < threshold 2. Project Falcon: 0. Nothing fires.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dataset_id\": \"{{dataSetId}}\",\n  \"text\": \"Payroll runs Friday.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"exactly the spec shape\", () => pm.expect(pm.response.json()).to.eql({status: \"not matched\"}));"
                ]
              }
            }
          ]
        },
        {
          "name": "Scan: whole words only",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/scan",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "scan"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dataset_id\": \"{{dataSetId}}\",\n  \"text\": \"The salaryman met falconry fans.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"substrings never count\", () => pm.expect(pm.response.json().status).to.eql(\"not matched\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Errors (RFC 9457 Problem Details)",
      "item": [
        {
          "name": "Invalid Data Type (threshold 0)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/datatypes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "datatypes"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Invalid {{suffix}}\",\n  \"type\": \"keywords\",\n  \"content\": [\n    \"x\"\n  ],\n  \"threshold\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"code is VALIDATION_ERROR\", () => pm.expect(pm.response.json().code).to.eql(\"VALIDATION_ERROR\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Duplicate name",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/datatypes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "datatypes"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Financial {{suffix}}\",\n  \"type\": \"keywords\",\n  \"content\": [\n    \"salary\"\n  ],\n  \"threshold\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"code is DUPLICATE_NAME\", () => pm.expect(pm.response.json().code).to.eql(\"DUPLICATE_NAME\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Data Set with an unknown Data Type id",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/datasets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "datasets"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Broken {{suffix}}\",\n  \"data_type_ids\": [\n    \"00000000-0000-4000-8000-000000000000\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"code is UNKNOWN_DATA_TYPES\", () => pm.expect(pm.response.json().code).to.eql(\"UNKNOWN_DATA_TYPES\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete a Data Type that a Data Set uses",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/datatypes/{{financialId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "datatypes",
                "{{financialId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"code is DATA_TYPE_IN_USE\", () => pm.expect(pm.response.json().code).to.eql(\"DATA_TYPE_IN_USE\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Scan an unknown Data Set",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/scan",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "scan"
              ]
            },
            "description": "Never 'not matched': nothing was scanned, so claiming the text is clean would be wrong.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dataset_id\": \"00000000-0000-4000-8000-000000000000\",\n  \"text\": \"salary\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"code is UNKNOWN_DATASET\", () => pm.expect(pm.response.json().code).to.eql(\"UNKNOWN_DATASET\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get an unknown Data Type",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/datatypes/00000000-0000-4000-8000-000000000000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "datatypes",
                "00000000-0000-4000-8000-000000000000"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"code is DATA_TYPE_NOT_FOUND\", () => pm.expect(pm.response.json().code).to.eql(\"DATA_TYPE_NOT_FOUND\"));"
                ]
              }
            }
          ]
        }
      ]
    },
